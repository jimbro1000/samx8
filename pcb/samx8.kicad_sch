		(uuid "33327e0e-1197-4a07-bf6d-15500aaafa9c")
	)
	(text_box "Various DRAM signals tied high so that any installed DRAM installed on the motherboard doesn't interfere with operation (probably saves power too)."
		(exclude_from_sim no)
		(at 254 63.5 0)
		(size 30.48 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
