	)
	(text_box "512K of SRAM organised as 256K x 16 bits (selected purely due to availability).\n\nCPLD selects between upper and lower byte - the other set will always be high-Z, so the data lines can be connected together."
		(exclude_from_sim no)
		(at 20.32 152.4 0)
		(size 30.48 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type default)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5f0d1ca9-5209-4713-b412-0d9c33259141")
	)
	(text_box "Replaces the '244 on the motherboard.\n\nWith the rejigged timings and fast SRAM, this might not even be needed if the SRAM had 5V tolerant inputs."
