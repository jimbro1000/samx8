		(uuid "4eb0f29c-a197-4eb0-adbc-e6a31eeb40d1")
	)
	(text_box "3.3V regulator.\n\nXXX this probably needs to be a higher power part now."
		(exclude_from_sim no)
		(at 256.54 96.52 0)
