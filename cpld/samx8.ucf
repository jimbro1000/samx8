# SAMx8

## Inputs from SAM socket

NET A<0> LOC = P85;
NET A<1> LOC = P82;
NET A<2> LOC = P80;
NET A<3> LOC = P78;
NET A<4> LOC = P76;
NET A<5> LOC = P73;
NET A<6> LOC = P74;
NET A<7> LOC = P77;
NET A<8> LOC = P8;
NET A<9> LOC = P9;
NET A<10> LOC = P10;
NET A<11> LOC = P11;
NET A<12> LOC = P3;
NET A<13> LOC = P7;
NET A<14> LOC = P6;
NET A<15> LOC = P4;

NET DA0 LOC = P22 | BUFG = CLK;
NET OscOut LOC = P23 | BUFG = CLK;

NET nHS LOC = P2;
NET RnW LOC = P87;
# Reset is indirect, so while this would normally be an SR pin, it doesn't make
# sense to configure it as such:
NET nER LOC = P99;
#NET nER LOC = P99 | BUFG = DATA_GATE;

## Outputs to SAM socket

NET S<0> LOC = P86 | SLEW = FAST;
NET S<1> LOC = P81 | SLEW = FAST;
NET S<2> LOC = P79 | SLEW = FAST;

NET Q LOC = P97;
NET E LOC = P93;
NET nRAS0 LOC = P95; # | BUFG = DATA_GATE;
NET VClk LOC = P1;

## Outputs to SRAM

NET Z<18> LOC = P43;
NET Z<17> LOC = P46;
NET Z<16> LOC = P49;
NET Z<15> LOC = P55;
NET Z<14> LOC = P54;
NET Z<13> LOC = P52;
NET Z<12> LOC = P50;
NET Z<11> LOC = P30;
NET Z<10> LOC = P28;
NET Z<9> LOC = P29;
NET Z<8> LOC = P58;
NET Z<7> LOC = P18;
NET Z<6> LOC = P16;
NET Z<5> LOC = P14;
NET Z<4> LOC = P12;
NET Z<3> LOC = P65;
NET Z<2> LOC = P64;
NET Z<1> LOC = P63;
NET Z<0> LOC = P33 | SLEW = FAST;
NET nZ0 LOC = P32 | SLEW = FAST;   # inverted Z<0>

NET nCE LOC = P27;
NET nWE LOC = P53;

## Data bus

NET D<7> LOC = P34;
NET D<6> LOC = P39;
NET D<5> LOC = P40;
NET D<4> LOC = P37;
NET D<3> LOC = P42;
NET D<2> LOC = P41;
NET D<1> LOC = P35;
NET D<0> LOC = P36;

## Outputs to buffer control / other

NET nGE LOC = P24;
NET GDIR LOC = P72;

## 21 Inputs

# Timing constraints

NET OscOut TNM_NET = OSC;
TIMESPEC TS_OSC = PERIOD OSC 69.841 nS HIGH 50.000 %;

NET A<*> TNM_NET = A;
NET S<*> TNM_NET = S;
NET Z<*> TNM_NET = Z;
TIMESPEC TS_A_S = FROM A TO S 18 ns;
TIMESPEC TS_A_Z = FROM A TO Z 28 ns;
